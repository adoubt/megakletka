; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hatbound"
run/main_scene="uid://bsoxxlhnjn45f"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="uid://cd0u1x3m2gydb"

[autoload]

DatabaseManager="*res://scripts/autoload/DatabaseManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
UIManager="*res://scripts/autoload/UIManager.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
ControllerManager="res://scripts/autoload/ControllerManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://dkkhufjn8avcs"

[editor_plugins]

enabled=PackedStringArray("res://addons/SmoothScroll/plugin.cfg", "res://addons/cba/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

grabbable=""
drone=""
player=""
controllable=""

[gui]

fonts/dynamic_fonts/use_oversampling=false
theme/custom_font="uid://bjrss4qesetwq"

