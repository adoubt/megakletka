[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true
sensors/enable_magnetometer=true

[layer_names]

3d_render/layer_20="mirror"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="PlayerProjectile"
3d_physics/layer_5="EnemyProjectile"
3d_physics/layer_6="PlayerHitBox"
3d_physics/layer_7="EnemyHitBox"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

occlusion_culling/bvh_build_quality=0
global_illumination/gi/use_half_resolution=true
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_use_jitter=true
environment/ssao/quality=0
environment/ssil/quality=0
occlusion_culling/occlusion_rays_per_thread=128
global_illumination/sdfgi/probe_ray_count=0
global_illumination/sdfgi/frames_to_converge=0
global_illumination/sdfgi/frames_to_update_lights=4
environment/volumetric_fog/use_filter=0
limits/opengl/max_lights_per_object=3
occlusion_culling/use_occlusion_culling=true
